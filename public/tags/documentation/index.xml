    <item>
      <title>Typst vs LaTeX</title>
      <link>http://localhost:1313/tech/typst_vs_latex/typst_vs_latex/</link>
      <pubDate>Wed, 03 Dec 2025 00:00:00 +0000</pubDate>
      <guid isPermaLink="true">http://localhost:1313/tech/typst_vs_latex/typst_vs_latex/</guid>
