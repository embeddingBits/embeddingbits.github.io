    <item>
      <title>Connect to college WiFi using nmtui or networkmanager</title>
      <link>http://localhost:1313/tech/nmtui/nmtui/</link>
      <pubDate>Tue, 13 Jan 2026 21:02:57 +0530</pubDate>
      <guid isPermaLink="true">http://localhost:1313/tech/nmtui/nmtui/</guid>
